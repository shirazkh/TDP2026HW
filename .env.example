PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=issueflow
DB_PASSWORD=issueflow
DB_NAME=issueflow

# Optional alternative to DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD/DB_NAME.
# DATABASE_URL=postgres://issueflow:issueflow@localhost:5432/issueflow

# Enabled by default for the current assignment skeleton so tables are generated
# during development startup. Disable when migrations are introduced.
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false

JWT_SECRET=change-this-development-secret
JWT_EXPIRES_IN_SECONDS=3600
